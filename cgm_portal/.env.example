# cgm.pdhc — example environment file
# Copy to .env and fill values. Never commit the real .env.

# CGM Portal Configuration
FLASK_APP=
FLASK_ENV=
SECRET_KEY=

# PostgreSQL (port 9081)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Bootstrap superuser API key (first run only)
BOOTSTRAP_API_KEY=
BOOTSTRAP_PROVIDER_NAME=

# Flask
FLASK_PORT=

# Instance identity (one provider per instance)
PROVIDER_GUID=
PROVIDER_NAME=

# Upstream request service
REQUEST_SERVICE_URL=
SSO_API_KEY=
PROVIDER_TOKEN=

# Push reception
PUSH_SECRET=

# Gateway receipt ingestion
GATEWAY_SERVICE_KEY=

# Sync settings
SYNC_INTERVAL_SECONDS=
SYNC_ENABLED=
